---
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
import { formatPrice, lessonCount, type Course } from '../data/courses';

interface Props {
  course: Course;
}

const { course } = Astro.props;
const lessons = lessonCount(course);
---

<Card class="flex h-full flex-col">
  <div class="flex flex-wrap items-center gap-2">
    <Badge>{course.level}</Badge>
    <Badge tone="cyan">Sample</Badge>
  </div>

  <h3 class="mt-5 text-card-heading">
    <a
      href={`/courses/${course.slug}`}
      class="rounded-[6px] underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-charcoal"
    >
      {course.title}
    </a>
  </h3>

  <p class="mt-3 text-body">{course.summary}</p>

  <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-caption text-graphite-copy">
    <div class="flex gap-1.5">
      <dt class="sr-only">Lessons</dt>
      <dd>{lessons} lessons</dd>
    </div>
    <div class="flex gap-1.5">
      <dt class="sr-only">Duration</dt>
      <dd>{course.duration}</dd>
    </div>
    <div class="flex gap-1.5">
      <dt class="sr-only">Price</dt>
      <dd>Sample {formatPrice(course.pricePaise)}</dd>
    </div>
  </dl>

  <div class="mt-auto pt-6">
    <Button href={`/courses/${course.slug}`} variant="secondary" size="sm">
      View course
    </Button>
  </div>
</Card>
