---
import Button from './Button.astro';

const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/courses', label: 'Courses' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-4 z-40 px-gutter">
  <nav
    aria-label="Main navigation"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between rounded-[30px] border border-mist-border/90 bg-paper-white/85 px-4 shadow-float backdrop-blur-xl sm:px-6"
  >
    <a
      href="/"
      class="flex items-center gap-3 rounded-[12px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-charcoal"
    >
      <span
        aria-hidden="true"
        class="grid h-8 w-8 place-items-center rounded-full border border-charcoal bg-charcoal text-[11px] font-semibold tracking-tight text-paper-white"
      >
        LE
      </span>
      <span class="leading-none">
        <span class="block text-[10px] font-medium tracking-[0.16em] text-graphite-copy uppercase">
          ServiceNow
        </span>
        <span class="font-display mt-1 block text-[19px] text-editorial-ink">Learn Easy</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-[9999px] px-4 py-2 text-label transition-colors hover:bg-air-wash hover:text-editorial-ink',
              isCurrent(link.href)
                ? 'bg-air-wash font-medium text-editorial-ink'
                : 'text-graphite-copy',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden items-center gap-2 md:flex">
      <a
        href="/login"
        class="rounded-[12px] px-3 py-2 text-label font-medium text-editorial-ink hover:bg-air-wash"
      >
        Log in
      </a>
      <Button href="/register" size="sm">
        Start learning
      </Button>
    </div>

    <details class="relative md:hidden">
      <summary
        aria-label="Open menu"
        class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full border border-mist-border bg-paper-white text-editorial-ink hover:border-ash-copy [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">Open menu</span>
        <svg
          aria-hidden="true"
          width="18"
          height="14"
          viewBox="0 0 18 14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M1 1h16M1 7h16M1 13h16"></path>
        </svg>
      </summary>

      <div class="absolute top-full right-0 mt-3 w-72 rounded-[20px] border border-mist-border bg-paper-white p-4 shadow-float">
        <ul class="space-y-1">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-[12px] px-4 py-3 text-label hover:bg-air-wash',
                  isCurrent(link.href)
                    ? 'bg-air-wash font-medium text-editorial-ink'
                    : 'text-graphite-copy',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 border-t border-mist-border pt-4">
          <a href="/login" class="block rounded-[12px] px-4 py-3 text-label font-medium">
            Log in
          </a>
          <Button href="/register" size="sm" class="mt-2 w-full">
            Start learning
          </Button>
        </div>
      </div>
    </details>
  </nav>
</header>
