---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Nav from '../components/ui/Nav.astro';
---

<BaseLayout title="ServiceNow Learn Easy">
  <Nav />
  <main
    id="main"
    class="mx-auto flex min-h-[70vh] max-w-6xl flex-col justify-center px-gutter py-section"
  >
    <p class="text-utility font-medium uppercase text-graphite-copy">ServiceNow Learn Easy</p>
    <h1 class="font-display mt-6 max-w-3xl text-hero-heading text-balance text-editorial-ink">
      Practical ServiceNow training, built for working professionals.
    </h1>
    <p class="mt-6 max-w-2xl text-body">
      Course catalog and learning platform are under construction. Phase 2 design system is ready
      for review.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/design" size="lg">
        View design system
      </Button>
      <Button href="/api/health" variant="secondary" size="lg">
        Health check
      </Button>
    </div>
  </main>
</BaseLayout>
