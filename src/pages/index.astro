---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ServiceNow Learn Easy">
  <main id="main" class="mx-auto flex min-h-screen max-w-4xl flex-col justify-center px-6 py-16">
    <p class="text-sm font-medium tracking-widest text-ash-copy uppercase">ServiceNow Learn Easy</p>
    <h1 class="font-display mt-6 text-4xl leading-tight text-editorial-ink sm:text-5xl">
      Practical ServiceNow training, built for working professionals.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-graphite-copy">
      Course catalog and learning platform are under construction. Phase 1 foundation is complete.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        class="rounded-[12px] bg-charcoal px-6 py-3 text-sm font-medium text-paper-white hover:bg-editorial-ink"
        href="https://github.com/kvvasu/ABHYASA"
      >
        Project repository
      </a>
      <a
        class="rounded-[12px] border border-mist-border px-6 py-3 text-sm font-medium text-editorial-ink hover:bg-air-wash"
        href="/api/health"
      >
        Health check
      </a>
    </div>
  </main>
</BaseLayout>
